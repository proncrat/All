{
  "name": "all",
  "type": "module",
  "version": "0.2.0",
  "description": "I love slop",
  "repository": "https://github.com/proncrat/All",
  "main": "server/index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "run-p dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "render:build": "npm install && npm run build && ls dist && npm prune --omit=dev && NODE_ENV='production' npm run knex migrate:latest && NODE_ENV='production' npx auth@latest migrate --config ./server/lib/auth.ts -y",
    "render:start": "node dist/server.js",
    "build": "run-s build:client build:server",
    "build:client": "vite build",
    "build:server": "esbuild --packages=external --platform=node --format=esm --outfile=dist/server.js --bundle server/index.ts",
    "test": "vitest",
    "knex": "knex --knexfile ./server/database/knexfile.js",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "format": "prettier -w '**/*.{js,jsx,ts,tsx}'"
  },
  "eslintConfig": {
    "extends": "@devacademy/eslint-config/react",
    "ignorePatterns": [
      "bundle.js"
    ]
  },
  "author": "Jullian",
  "devDependencies": {
    "@devacademy/eslint-config": "^1.10.2",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/superagent": "^8.1.11",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "browserslist": "> 2%, not dead",
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color.js": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-ws": "^5.0.2",
    "knex": "^3.3.0",
    "lucide-react": "^1.60.0",
    "multer": "^2.4.0",
